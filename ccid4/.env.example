# คัดลอกเป็น .env แล้วแก้ค่า · ห้าม commit .env
DJANGO_SECRET_KEY=ใส่ค่าสุ่มยาวอย่างน้อย 50 ตัวอักษร   # python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=ccid4.local,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://ccid4.local
CCID4_HOST=ccid4.local
POSTGRES_PASSWORD=ใส่รหัสผ่านฐานข้อมูล
DATABASE_URL=postgres://ccid4:ใส่รหัสผ่านฐานข้อมูล@db:5432/ccid4
REDIS_URL=redis://redis:6379/0
CCID4_DEMO_MODE=false
CCID4_UNIT_NAME=กองกำกับการ 1 กองบังคับการตำรวจสืบสวนสอบสวนอาชญากรรมทางเทคโนโลยี 4
CCID4_UNIT_SHORT=กก.1 บก.สอท.4
# AI ในเครื่อง (เปิดเมื่อมีเครื่อง GPU): AI_BACKEND=ollama, OLLAMA_MODEL=ชื่อโมเดลที่ pull ไว้
AI_BACKEND=fake
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_TIMEOUT=90
# OCR ภาพบันทึกจับกุม/บัตร: OCR_BACKEND=ollama และ OCR_MODEL=โมเดล OCR แบบ open-weight ที่ pull ไว้
OCR_BACKEND=fake
OCR_MODEL=
# ที่อยู่หน้ารับแจ้งความที่ประชาชนเข้าถึงได้ (พิมพ์ลง QR) เช่น https://report.example.go.th
CCID4_PUBLIC_URL=
# CCID4_WITH_ASR=true ติดตั้งโปรแกรมถอดเสียงใน image (CPU) แล้ว docker compose up -d --build
CCID4_WITH_ASR=false
ASR_BACKEND=fake
# ถอดเสียง: python manage.py setup_asr (โหลดโมเดลครั้งเดียว) แล้วตั้ง ASR_BACKEND=whisper, ASR_MODEL=/models/asr/<ชื่อรุ่น>
# เครื่องเดียวสำหรับทดลอง: ใช้ scripts/install_local.* ซึ่งตั้งค่าเหล่านี้ให้เอง · แยกผู้พูด (GPU): DIARIZATION_MODEL=/models/pyannote
# แล้วรัน docker compose --profile gpu up -d และตั้ง CCID4_ASR_QUEUE=true
ASR_MODEL=
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
# 0 = อัตโนมัติ (CPU ใช้ 1 เร็วกว่าราว 2 เท่า · GPU ใช้ 5) · ตั้ง 5 ถ้าต้องการแม่นสุดและรอได้
ASR_BEAM_SIZE=0
# 0 = ใช้ทุกแกนจริงของ CPU
ASR_CPU_THREADS=0
DIARIZATION_MODEL=
CCID4_ASR_QUEUE=false
TZ=Asia/Bangkok
# ---- เฟส 11: แจ้งเตือน (B8) และเครื่องอ่านบัตร (B9) ----
# สรุปรายวันทางอีเมลผ่าน SMTP ภายในหน่วย (ผู้ใช้เลือกเปิดเองที่หน้าภาพรวม)
CCID4_DAILY_DIGEST=false
CCID4_SITE_URL=https://ccid4.local
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=ccid4@unit.local
# ช่องทางภายนอก (ส่งข้อมูลออกนอกเครือข่าย) ปิดไว้ · เปิดเมื่อได้รับอนุมัติเท่านั้น เช่น CCID4_EXTERNAL_CHANNELS=webhook
CCID4_EXTERNAL_CHANNELS=
CCID4_WEBHOOK_URL=
# card-agent บนเครื่องผู้ใช้
CCID4_CARD_AGENT_URL=ws://127.0.0.1:8765
