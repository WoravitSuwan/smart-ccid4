# Copy to .env and edit. Never commit .env.
CCID4_SECRET_KEY=change-me-to-a-long-random-string   # openssl rand -hex 32
CCID4_DEMO_MODE=false                                 # true shows the "ข้อมูลจำลอง" badge
CCID4_COOKIE_SECURE=true                              # true when served over HTTPS (required in production)
CCID4_SESSION_HOURS=8
CCID4_UNIT_NAME=กองกำกับการ 1 กองบังคับการตำรวจสืบสวนสอบสวนอาชญากรรมทางเทคโนโลยี 4
CCID4_UNIT_SHORT=กก.1 บก.สอท.4
CCID4_CLOSED_STATUSES=สิ้นสุด,ส่งอัยการแล้ว
# Database: SQLite by default (file in the data volume). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://ccid4:password@db:5432/ccid4
# Speech recognition on this server (optional, see README):
# CCID4_ASR_MODEL=large-v3
# CCID4_ASR_DEVICE=cuda
TZ=Asia/Bangkok
